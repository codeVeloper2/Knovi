# ── PostgreSQL (Supabase or local) ───────────────
# Supabase: Project Settings -> Database -> Connection string -> URI
# URL-encode special chars in the password: @->%40 /->%2F (->%28 )->%29 '->%27
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ── JWT (session tokens issued by this backend) ──
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=generate-with-python-secrets-token-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
EMAIL_TOKEN_EXPIRE_MINUTES=1440

# ── Firebase Admin (Google sign-in only) ──
# Path to your Firebase service account JSON, or leave unset
# and place the file at backend/serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=

# ── Supabase Storage (avatar uploads) ────────────
# SUPABASE_URL is auto-derived from DATABASE_URL's project ref if left blank.
# service_role key: Supabase dashboard -> Project Settings -> API -> service_role
# SERVER-SIDE ONLY — never expose in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_AVATAR_BUCKET=avatars

# ── Chat encryption (AES-256-GCM) ───────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
CHAT_ENCRYPTION_KEY=

# ── CORS / frontend ─────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ── Email (SMTP) ────────────────────────────────
# Backend sends verification + password-reset emails. If left blank,
# endpoints still work in development and return the link in the response.
# Gmail example (use a Google "App Password"):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-app-password
#   SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=PeerUP
SMTP_USE_TLS=true
