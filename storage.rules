rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile avatars. Reads are public so images render for everyone.
    // Writes are limited to images under 5MB. NOTE: because email/password
    // users authenticate through the backend (not Firebase Auth), uploads
    // here are not gated on Firebase auth — only on file type/size.
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
